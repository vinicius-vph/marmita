NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# bcrypt hash encoded in base64 — base64 avoids $ expansion by dotenv
# Generate with: node -e "require('bcryptjs').hash('your-password',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
ADMIN_PASSWORD_HASH=base64encodedBcryptHashHere
AUTH_SECRET=random-32-characters-secret
# 32 random bytes in base64 - encrypts customer name/phone. Losing it means losing that data: keep a copy in a secrets vault.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Add PII_ENCRYPTION_KEY_V2, _V3, ... to rotate — see docs/operations/pii-encryption.md.
PII_ENCRYPTION_KEY_V1=
# Which PII_ENCRYPTION_KEY_V<n> new writes use. Not a secret. Defaults to 1 when unset.
PII_ENCRYPTION_KEY_ACTIVE_VERSION=1
# Dev only — comma-separated list of allowed origins (defaults to 127.0.0.1,localhost)
ALLOWED_DEV_ORIGINS=127.0.0.1,localhost
# Set to 'true' in CI/test environments to bypass rate limiting and avoid DB pollution
RATE_LIMIT_DISABLED=false
MBWAY_PHONE=+000123456789
WHATSAPP_PHONE=+000123456789
BANK_IBAN=PT50000000000000000000000
INSTAGRAM_URL=https://www.instagram.com/
FACEBOOK_URL=https://www.facebook.com/
# Comma-separated list of opt-in features. Empty = all features off.
# Valid values: breakfast
NEXT_PUBLIC_ENABLED_FEATURES=